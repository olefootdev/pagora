# PAGORA — variáveis públicas do frontend (prefixo VITE_ é exposto ao client)
# Copie esse arquivo para .env.local e preencha com as chaves do seu projeto Supabase.
# A anon key é segura no frontend; a service_role NUNCA vai aqui.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# Número da central PAGORA no WhatsApp (E.164 sem '+').
# Recebe os pedidos disparados pelos botões "Enviar via WhatsApp" nas summary screens.
VITE_PAGORA_WPP_NUMBER=5511999999999

# Analytics. Vazio = não carrega o snippet (zero requests pra Google / Meta em dev).
# GA4 measurement ID — formato G-XXXXXXXXXX
VITE_GA4_ID=
# Meta Pixel ID — formato numérico de 15-16 dígitos
VITE_META_PIXEL_ID=

# Google Maps. VAZIO É UM ESTADO VÁLIDO: sem chave, as telas de mapa caem na
# ilustração estática e o app continua navegável. Nada quebra, nada é cobrado.
#
# Esta chave FICA VISÍVEL no bundle — é assim que o Maps funciona no browser.
# A proteção não é o segredo, é a restrição: no console do Google, limite a
# chave por referrer HTTP (localhost:5173 e seu domínio) e habilite só as APIs
# Maps JavaScript, Directions, Places (New) e Geocoding.
VITE_GOOGLE_MAPS_API_KEY=

# =====================================================================
# O QUE NUNCA ENTRA NESTE ARQUIVO
# =====================================================================
# Tudo que tem prefixo VITE_ é inlineado no bundle e vai parar no browser de
# qualquer visitante. Estes valores ficam nos secrets da Edge Function
# (`supabase secrets set`), nunca aqui, nem com outro nome:
#
#   ASAAS_API_KEY              → move dinheiro da conta principal
#   ASAAS_WEBHOOK_TOKEN        → quem o tiver consegue forjar "pagamento recebido"
#   SUPABASE_SERVICE_ROLE_KEY  → ignora toda a RLS
#
# Ver supabase/README.md. O teste `financial-invariants.test.ts` falha o build
# se alguma dessas strings aparecer em src/.
